# Конфигурация nginx для CRM «Школа каратэ Николаевой Антонины».
# Файл кладётся на сервер в /etc/nginx/sites-available/karate-crm,
# затем: ln -s /etc/nginx/sites-available/karate-crm /etc/nginx/sites-enabled/
#        nginx -t && systemctl reload nginx
# SSL добавит certbot автоматически: certbot --nginx -d ВАШ-ДОМЕН.ru
server {
    listen 80;
    server_name ВАШ-ДОМЕН.ru;   # <-- заменить на настоящий домен

    # Статика собранного фронтенда (React)
    root /opt/karate/web/dist;
    index index.html;

    # Загруженные файлы (фото тренеров, баннеры) отдаёт бэкенд
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        client_max_body_size 50m;
    }

    # Все запросы API — на Node.js
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
    }

    location /health {
        proxy_pass http://127.0.0.1:4000;
    }

    # Файлы сборки содержат хэш в имени — их можно кэшировать надолго
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Стартовую страницу и сервис-воркер НЕ кэшируем, иначе после обновления
    # системы у сотрудников продолжит открываться старая версия
    location = /index.html { add_header Cache-Control "no-store, must-revalidate"; }
    location = /sw.js      { add_header Cache-Control "no-store, must-revalidate"; }

    # SPA: любой другой адрес отдаёт index.html (маршруты рисует React)
    location / {
        add_header Cache-Control "no-store, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
