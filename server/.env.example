# ==========================================================================
# Настройки сервера CRM «Школа каратэ Николаевой Антонины»
# Скопируйте этот файл в .env (в этой же папке server/) и заполните значения.
# Файл .env никогда не выкладывается в интернет и не попадает в git.
# ==========================================================================

# --- База данных (PostgreSQL) ---
# Формат: postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@АДРЕС:5432/ИМЯ_БАЗЫ
DATABASE_URL=postgres://karate:karate@localhost:5432/karate

# --- Безопасность ---
# Длинная случайная строка для подписи токенов входа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Сервер ---
PORT=4000
# Адрес фронтенда для CORS. Локально — адрес Vite, в проде — ваш домен.
CLIENT_ORIGIN=http://localhost:5173

# --- ПРОД: один процесс отдаёт и сайт, и API ---
# Путь к собранному фронтенду (папка web/dist на сервере). Локально оставить пустым.
CLIENT_DIST=

# --- Первичное наполнение базы (npm run seed) ---
# Логин и пароль владельца, который создаётся при первом запуске сида.
SEED_ADMIN_EMAIL=admin@karate.ru
SEED_ADMIN_PASSWORD=admin123
